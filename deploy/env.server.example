# .env for the always-on server. Copy to the project root on the target host.
#
# DATA_DIR is deliberately absent: docker-compose.yml pins it to /data inside
# the container. Setting it here would point the bot at the wrong directory.

ADMIN_PASSWORD=CHANGE_ME
# Keeps admin logins valid across restarts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

WEB_PORT=8080
WEB_HOST=0.0.0.0

NODE_ENV=production
LOG_LEVEL=info

WHATSAPP_ENABLED=1
# Empty = link by QR code (shown in `docker compose logs`). Set to the bot's own
# number, digits only, to link by pairing code instead.
WHATSAPP_PAIRING_NUMBER=

# Only 1 behind an HTTPS reverse proxy; it makes the session cookie Secure-only.
TRUST_PROXY=0

TZ=Europe/Berlin
