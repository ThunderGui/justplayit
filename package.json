{
  "name": "justplayit",
  "version": "0.1.0",
  "private": true,
  "description": "Just Play It — WhatsApp bot that manages padel bookings, waiting lists and who-owes-who.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "^6.7.18",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "ejs": "^7.0.1",
    "express": "^4.22.3",
    "luxon": "^3.5.0",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
