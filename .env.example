# Copy to .env and adjust. Never commit the real .env.

# --- Admin web console -----------------------------------------------------
# Required. The console refuses every login until this is set.
ADMIN_PASSWORD=change-me

# Keeps admin sessions valid across restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty a new secret is generated on each boot, so you simply log in again.
SESSION_SECRET=

# Port for the console. Set to 0 to run the bot with no web interface at all.
WEB_PORT=8080
WEB_HOST=0.0.0.0

# --- Storage ---------------------------------------------------------------
# Holds the SQLite database, the WhatsApp device credentials and payment proofs.
# Back this folder up; it is the entire state of the bot.
DATA_DIR=./data

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# Set to 0 to boot without connecting to WhatsApp (useful while developing
# the web console, or for running against the database alone).
WHATSAPP_ENABLED=1

# Link by pairing code instead of scanning a QR code. Set this to the bot's own
# number, international format, digits only (e.g. 4915112345678).
# Use this when the bot's WhatsApp runs in an Android emulator, which has no
# camera to scan a QR code with. Leave empty to link by QR.
WHATSAPP_PAIRING_NUMBER=

# Set to 1 only when the console is served over HTTPS behind a reverse proxy;
# it makes the session cookie Secure-only.
TRUST_PROXY=0

# Dedicated Playtomic account the bot reads shared matches with (optional).
# Without it, Playtomic links are still shown, just not enriched with live
# roster/slot data. One account serves every group. Use a throwaway account.
PLAYTOMIC_EMAIL=
PLAYTOMIC_PASSWORD=
